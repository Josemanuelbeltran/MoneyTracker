# Plantilla de /etc/default/moneytracker-backup — a donde va el correo del backup.
#
#   sudo install -m 644 ops/moneytracker-backup.env.example /etc/default/moneytracker-backup
#   sudo nano /etc/default/moneytracker-backup
#
# Sin MAIL_TO el backup se hace igual, pero no manda nada por correo: la copia
# se queda solo en el servidor.

MAIL_TO=TU_CORREO@gmail.com

# Remitente. Tiene que ser la misma cuenta que la de /etc/msmtprc, o Gmail
# rechaza el envio.
MAIL_FROM=TU_CORREO@gmail.com
